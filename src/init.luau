local React = require(script.Parent:FindFirstChild("react"))

local e = React.createElement

type Binding<T> = React.Binding<T>
type BindingOrValue<T> = T | Binding<T>
type ChangeHandler<T> = (rbx: T) -> ()

local function resolveHostProps(props: any): any
    local hostProps = table.clone(props)

    local events = hostProps.Event
    hostProps.Event = nil
    if events then
        for name, callback in events do
            hostProps[React.Event[name]] = callback
        end
    end

    local changes = hostProps.Change
    hostProps.Change = nil
    if changes then
        for name, callback in changes do
            hostProps[React.Change[name]] = callback
        end
    end

    return hostProps
end

